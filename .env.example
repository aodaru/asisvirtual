# ==============================================================================
# Supabase Self-Hosted — Variables de Entorno
# ==============================================================================
# Despliegue real en 10.0.5.16 (TrueNAS SCALE). Copia como .env y completa
# los placeholders de secretos. El .env real NUNCA se commitea (.gitignore).
#
# Genera secretos seguros con:
#   openssl rand -base64 48   (para claves de 64+ chars)
#   openssl rand -base64 24   (para claves de 32+ chars)
#
# Stack oficial de Supabase: /mnt/Aodnas/Docker/supabase/docker/
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
# Conexión directa (sin pooler): 10.0.5.16:5433
# Conexión vía Supavisor (pooler): 10.0.5.16:5432
POSTGRES_HOST=10.0.5.16
POSTGRES_PORT=5433
POSTGRES_DB=supabase
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# ------------------------------------------------------------------------------
# JWT (Legacy HS256)
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Legacy API keys (HS256-signed JWTs)
# Generadas con el JWT_SECRET real del servidor (no el placeholder de demo)
# Para regenerar: python3 script_jwt.py con el JWT_SECRET de tu .env
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.oZm99tnAH-DfNSBNzCNN5QkpV5rldWl_o-K2y3J3-HQ
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.lfsFoVxC8vajSsIULDksCdSpTPPITXsAAzh_vnxIJvM

# ------------------------------------------------------------------------------
# JWT Asimétrico (ES256) — opcional, dejar vacío para usar HS256 legacy
# ------------------------------------------------------------------------------
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# ------------------------------------------------------------------------------
# Encryption Keys
# ------------------------------------------------------------------------------
# Mínimo 64 caracteres: openssl rand -base64 48
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
# Mínimo 32 caracteres: openssl rand -base64 24
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min
VAULT_ENC_KEY=your-vault-encryption-key-32-chars

# ------------------------------------------------------------------------------
# Studio UI
# ------------------------------------------------------------------------------
# Acceso: http://10.0.5.16:30164
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-dashboard-password

# ------------------------------------------------------------------------------
# Kong (API Gateway)
# ------------------------------------------------------------------------------
KONG_HTTP_PORT=30164
KONG_HTTPS_PORT=8443

# ------------------------------------------------------------------------------
# API / URLs
# ------------------------------------------------------------------------------
API_EXTERNAL_URL=http://10.0.5.16:30164
SUPABASE_PUBLIC_URL=http://10.0.5.16:30164
SITE_URL=http://10.0.5.16:30164
ADDITIONAL_REDIRECT_URLS=

# ------------------------------------------------------------------------------
# Auth (GoTrue)
# ------------------------------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# ------------------------------------------------------------------------------
# SMTP (emails de autenticación)
# ------------------------------------------------------------------------------
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=AsistVirtual

# ------------------------------------------------------------------------------
# Mailer URL Paths
# ------------------------------------------------------------------------------
MAILER_URLPATHS_INVITE=/verify
MAILER_URLPATHS_CONFIRMATION=/verify
MAILER_URLPATHS_RECOVERY=/verify
MAILER_URLPATHS_EMAIL_CHANGE=/verify

# ------------------------------------------------------------------------------
# PostgREST (REST API)
# ------------------------------------------------------------------------------
PGRST_DB_SCHEMAS=asisvirtual,public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=asisvirtual,public

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
STORAGE_TENANT_ID=local
REGION=local
GLOBAL_S3_BUCKET=supabase-storage-local
IMGPROXY_AUTO_WEBP=true
S3_PROTOCOL_ACCESS_KEY_ID=your-s3-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=your-s3-secret-key

# ------------------------------------------------------------------------------
# Edge Functions
# ------------------------------------------------------------------------------
FUNCTIONS_VERIFY_JWT=false

# ------------------------------------------------------------------------------
# Supavisor (Connection Pooler)
# ------------------------------------------------------------------------------
# Pooler escucha en puerto 5432 (proxy a PostgreSQL 5433)
POOLER_TENANT_ID=local
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=5000
POOLER_DB_POOL_SIZE=20
POOLER_PROXY_PORT_TRANSACTION=5432

# ------------------------------------------------------------------------------
# Realtime
# ------------------------------------------------------------------------------
REALTIME_DB_ENC_KEY=supabaserealtime

# ------------------------------------------------------------------------------
# Studio Defaults
# ------------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=TeaPartyDev
STUDIO_DEFAULT_PROJECT=AsistVirtual

# ------------------------------------------------------------------------------
# OpenAI (opcional — para funciones AI de Studio)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
